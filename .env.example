# ── Telegram ─────────────────────────────────────────────────────────────────
# Get from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram chat ID — used for proactive down-alerts
# Get it by sending a message to @userinfobot
TELEGRAM_OWNER_CHAT_ID=123456789

# Your Telegram user ID — used as the auth guard in groups/channels
# Usually the same number as TELEGRAM_OWNER_CHAT_ID (it's your user ID)
TELEGRAM_OWNER_USER_ID=123456789

# Comma-separated chat IDs where community commands are publicly accessible.
# Add your curated group chats and channels here.
# Your owner chat ID is always included automatically.
# Get a chat ID by forwarding a message from the chat to @userinfobot.
# Example: TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890,-1009876543210
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890

# ── Zeabur ───────────────────────────────────────────────────────────────────
# Zeabur dashboard → Account → Developer → Generate API token
ZEABUR_API_TOKEN=your_zeabur_api_token

# ── Admin page ───────────────────────────────────────────────────────────────
# Guards GET/POST /admin — the web UI for picking which Zeabur projects to scan
# for bots and which discovered services to exclude (replaces hand-editing
# ZEABUR_PROJECT_IDS / ZEABUR_EXCLUDED_SERVICE_IDS below).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Legacy — only read once, to seed the admin page's config on first startup
# if it hasn't been configured yet. After that, use /admin instead.
# ZEABUR_PROJECT_IDS=proj_id_1,proj_id_2
# ZEABUR_EXCLUDED_SERVICE_IDS=service_id_1,service_id_2

# ── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained PAT with Contents: read access to your bot repos
# https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=github_pat_xxxx
GITHUB_OWNER=TheBooleanJulian

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx

# ── Monitoring behaviour ─────────────────────────────────────────────────────
# How often to poll Zeabur for health (seconds). Default: 300 (5 min)
HEALTH_CHECK_INTERVAL=300

# Re-alert if a bot is still down after this many minutes. Default: 30
ALERT_REPEAT_MINUTES=30

# Default log lines to fetch. Default: 100
LOG_LINES_DEFAULT=100

# ── Health server ─────────────────────────────────────────────────────────────
# Port for GET /health and GET /status endpoints.
# Zeabur injects PORT automatically — only set this for local dev.
# HEALTH_SERVER_PORT=8080
